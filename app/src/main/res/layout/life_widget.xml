<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="#F4F1E8">
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="生活ボタン" android:textColor="#182820" android:textSize="14sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<Button style="@style/LifeEventButton" android:id="@+id/sleep_start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="就寝"/>
<Button style="@style/LifeEventButton" android:id="@+id/sleep_end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="起床"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<Button style="@style/LifeEventButton" android:id="@+id/departure" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="出発"/>
<Button style="@style/LifeEventButton" android:id="@+id/arrival" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="帰宅"/>
</LinearLayout>
<Button style="@style/LifeEventButton" android:id="@+id/concerta" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2" android:text="コンサータ\n服用"/>
</LinearLayout>
